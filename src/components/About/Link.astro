---
type Props = {
  href: string;
};

const { href } = Astro.props;
---

<a
  href={href}
  class="group font-inter text-light-gray hover:border-light-gray hover:bg-light-gray inline-flex items-center gap-x-3 border border-[#C4C4C4] px-6 py-2 text-sm lowercase transition-all duration-300 ease-in-out hover:text-white md:text-base"
>
  <slot />
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    class="transition-transform duration-300 ease-in-out group-hover:translate-x-1"
    aria-hidden="true"
  >
    <path d="M5 12h14"></path>
    <path d="m12 5 7 7-7 7"></path>
  </svg>
</a>
