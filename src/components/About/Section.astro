---
type Props = {
  imagePosition?: 'left' | 'right';
  contentColSpan?: string;
  visualColSpan?: string;
  alignItems?: 'start' | 'center' | 'end';
};

const {
  imagePosition = 'right',
  contentColSpan = 'md:col-span-7 lg:col-span-6',
  visualColSpan = 'md:col-span-5 lg:col-span-6',
  alignItems = 'center',
} = Astro.props;

const isImageLeft = imagePosition === 'left';

const alignmentClasses = {
  start: 'items-start',
  center: 'items-center',
  end: 'items-end',
} as const;
---

<section class="container mx-auto px-8 py-20">
  <div
    class:list={[
      'grid grid-cols-1 gap-12 md:grid-cols-12 md:gap-16',
      alignmentClasses[alignItems],
    ]}
  >
    <div class:list={[contentColSpan, { 'md:order-2': isImageLeft }]}>
      <slot />
    </div>

    <div
      class:list={[
        'flex flex-col',
        visualColSpan,
        isImageLeft ? 'md:order-1' : '',
      ]}
    >
      <slot name="visual" />
    </div>
  </div>
</section>
