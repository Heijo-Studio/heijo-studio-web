---
import { NAV_ITEMS } from 'src/constants';
---

<>
  <button
    id="menu-toggle"
    class="relative z-50 block cursor-pointer md:hidden"
    aria-label="Toggle Menu"
    aria-expanded="false"
    aria-controls="mobile-menu"
  >
    <div class="flex h-6 w-8 flex-col justify-between overflow-visible">
      <span class="h-0.5 w-full bg-[#757575]" id="line1"></span>
      <span class="h-0.5 w-full bg-[#757575]" id="line2"></span>
      <span class="h-0.5 w-full bg-[#757575]" id="line3"></span>
    </div>
  </button>

  <div id="mobile-menu" class="fixed inset-0 z-40 md:hidden" data-open="false">
    <div class="mobile-overlay" aria-hidden="true"></div>

    <aside
      class="mobile-panel flex h-full flex-col gap-y-12 px-6 py-6"
      role="dialog"
      aria-modal="true"
    >
      <nav>
        <ul class="flex flex-col gap-y-5">
          {
            NAV_ITEMS.map((item, index) => (
              <li
                class="opacity-0 transition-all duration-500"
                style={`--i: ${index}`}
              >
                <a
                  href={item.href}
                  class="font-inter text-light-gray hover:text- text-xl lowercase hover:text-[#C0BCBC]"
                >
                  {item.name}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </aside>
  </div>
</>

<style>
  #mobile-menu {
    pointer-events: none;
  }

  .mobile-overlay {
    position: fixed;
    inset: 0 0 0 0;
    background: rgba(0, 0, 0, 0);
    transition:
      background 0.28s ease,
      opacity 0.28s ease;
    opacity: 0;
    z-index: 40;
    pointer-events: none;
  }

  .mobile-panel {
    position: fixed;
    top: 0;
    right: 0;
    height: 100vh;
    width: var(--menu-width);
    background: white;
    transform: translateX(100%);
    transition: transform 0.8s cubic-bezier(0.2, 0.9, 0.2, 1);
    z-index: 45;
    box-shadow: -8px 0 24px rgba(0, 0, 0, 0.08);
    pointer-events: auto;
  }

  /* When open: show overlay and slide panel in */
  #mobile-menu[data-open='true'] {
    pointer-events: auto;
  }

  #mobile-menu[data-open='true'] .mobile-overlay {
    background: rgba(0, 0, 0, 0.3);
    opacity: 1;
    pointer-events: auto;
  }

  #mobile-menu[data-open='true'] .mobile-panel {
    transform: translateX(0);
  }

  #menu-toggle span {
    display: block;
    transform-origin: center;
    transition:
      transform 0.28s cubic-bezier(0.2, 0.9, 0.2, 1),
      opacity 0.28s ease;
  }

  #menu-toggle.open #line1 {
    transform: translateY(11px) rotate(45deg);
  }

  #menu-toggle.open #line2 {
    opacity: 0;
    transform: scaleX(0);
  }

  #menu-toggle.open #line3 {
    transform: translateY(-11px) rotate(-45deg);
  }

  /* Push the hamburger left when menu opens (so it appears to be pushed by the panel) */
  #menu-toggle {
    transition: transform 0.8s cubic-bezier(0.2, 0.9, 0.2, 1);
  }

  #menu-toggle.open {
    transform: translateX(calc(-1 * var(--menu-width)));
  }

  /* Ensure the cross is visible against the dark overlay when open */
  #menu-toggle.open span {
    background-color: #ffffff;
  }

  /* Menu items and socials animate in when menu is open */
  .mobile-panel ul li,
  .mobile-panel #mobile-socials {
    opacity: 0;
    transform: translateY(1rem);
    transition:
      opacity 0.5s ease,
      transform 0.5s ease;
  }

  #mobile-menu[data-open='true'] .mobile-panel ul li {
    opacity: 1;
    transform: translateY(0);
  }

  #mobile-menu[data-open='true'] .mobile-panel #mobile-socials {
    opacity: 1;
    transform: translateY(0);
  }

  /* Respect the per-item delay variable already set inline */
  .mobile-panel ul li {
    transition-delay: calc(var(--i) * 100ms);
  }
</style>

<script>
  const menuToggle = document.getElementById(
    'menu-toggle',
  ) as HTMLButtonElement | null;
  const mobileMenu = document.getElementById(
    'mobile-menu',
  ) as HTMLElement | null;

  function setOpen(open: boolean) {
    if (!mobileMenu || !menuToggle) return;
    mobileMenu.dataset.open = String(open);
    if (open) menuToggle.classList.add('open');
    else menuToggle.classList.remove('open');
    menuToggle.setAttribute('aria-expanded', String(open));
  }

  menuToggle?.addEventListener('click', () => {
    const next = mobileMenu?.dataset.open !== 'true';
    setOpen(Boolean(next));
  });

  mobileMenu?.querySelectorAll('li').forEach((li) => {
    li.addEventListener('click', () => setOpen(false));
  });
</script>
