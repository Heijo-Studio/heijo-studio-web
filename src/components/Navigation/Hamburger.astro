<button
  id="menu-toggle"
  class="menu-toggle-btn cursor-pointer md:hidden"
  aria-label="Toggle Menu"
  aria-expanded="false"
  aria-controls="mobile-menu"
>
  <div class="flex h-6 w-8 flex-col justify-between overflow-visible">
    <span class="h-0.5 w-full bg-[#757575]" id="line1"></span>
    <span class="h-0.5 w-full bg-[#757575]" id="line2"></span>
    <span class="h-0.5 w-full bg-[#757575]" id="line3"></span>
  </div>
</button>

<style>
  .menu-toggle-btn {
    position: fixed;
    top: 1.25rem;
    right: 1rem;
    z-index: 90;
  }

  #menu-toggle span {
    display: block;
    transform-origin: center;
    transition:
      transform 0.28s cubic-bezier(0.2, 0.9, 0.2, 1),
      opacity 0.28s ease;
  }

  #menu-toggle.open #line1 {
    transform: translateY(11px) rotate(45deg);
  }

  #menu-toggle.open #line2 {
    opacity: 0;
    transform: scaleX(0);
  }

  #menu-toggle.open #line3 {
    transform: translateY(-11px) rotate(-45deg);
  }
</style>
