---
import Instagram from './Icons/Instagram.astro';
import LinkedIn from './Icons/LinkedIn.astro';
---

<div class="mt-0.5 flex items-center gap-x-4 lowercase">
  <p class="text-light-gray h-full text-sm">Follow us</p>

  <a
    href="#"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Visit our Instagram profile"
    class="hover:text-light-gray text-gray-300 transition-colors"
  >
    <Instagram />
  </a>
  <a
    href="#"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Visit our LinkedIn profile"
    class="hover:text-light-gray text-gray-300 transition-colors"
  >
    <LinkedIn />
  </a>
</div>
