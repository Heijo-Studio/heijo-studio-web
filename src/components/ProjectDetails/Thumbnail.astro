---
import { Image } from 'astro:assets';
import type { Project } from '../../types/project';

type Props = {
  image: Project['data']['thumbnail'];
  title: string;
};

const { image, title } = Astro.props;
---

{
  image && (
    <Image
      src={image}
      alt={title}
      class="aspect-video w-full object-cover object-center"
    />
  )
}
