---
import { Image } from 'astro:assets';
import type { Project } from '../../types/project';

type Props = {
  image: Project['data']['thumbnail'];
  title: string;
};

const { image, title } = Astro.props;
---

{
  image && (
    <Image
      src={image}
      alt={title}
      fetchpriority="high"
      loading="eager"
      class="h-auto w-full"
    />
  )
}
