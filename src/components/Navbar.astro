---
import { NAV_ITEMS } from 'src/constants';
import Hamburger from './Hamburger.astro';
import Logo from './Logo.astro';
---

<header
  class="fixed top-0 left-0 z-50 w-full max-w-full bg-white/50 px-4 py-3 backdrop-blur-md md:px-8"
>
  <div class="container flex w-full max-w-full items-center justify-between">
    <a href="/">
      <Logo width={120} height={54} />
    </a>

    <nav class="hidden md:block">
      <ul class="flex items-center gap-x-8">
        {
          NAV_ITEMS.map((item) => (
            <li>
              <a
                href={item.href}
                class="font-inter text-light-gray lowercase transition-colors hover:text-black"
              >
                {item.name}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <Hamburger />
  </div>
</header>
