---
import { Image } from 'astro:assets';
import type { Project } from '../../types/project';

type Props = {
  project: Project;
};

const { project } = Astro.props;
const { title, thumbnail } = project.data;
const [category, slug] = project.id.split('/');
---

<a
  href={`/works/${category}/${slug}`}
  class="decoration-light-gray flex cursor-pointer flex-col gap-y-3 underline-offset-4 hover:underline"
>
  {
    thumbnail ? (
      <Image
        src={thumbnail}
        alt={title}
        loading="eager"
        class="aspect-4/3 w-full object-cover sm:aspect-auto sm:h-72.5"
      />
    ) : (
      <div class="aspect-4/3 w-full bg-gray-200 sm:aspect-auto sm:h-72.5" />
    )
  }

  <p class="font-inter text-light-gray text-sm md:text-base">
    {title}
  </p>
</a>
