---
import { NAV_ITEMS } from 'src/constants';
import Social from './Social.astro';

const currentYear = new Date().getFullYear();
---

<footer class="w-full px-4 py-2 md:px-8 md:py-3">
  <div
    class="container flex w-full max-w-full flex-col items-start justify-between gap-y-1 md:flex-row md:items-center md:gap-y-0"
  >
    <nav class="flex items-center gap-x-6">
      <ul class="hidden flex-wrap items-center gap-x-6 gap-y-2 md:flex">
        {
          NAV_ITEMS.map((item) => (
            <li>
              <a
                class="font-inter text-light-gray text-sm lowercase transition-colors hover:text-black"
                href={item.href}
              >
                {item.name}
              </a>
            </li>
          ))
        }
      </ul>

      <Social />
    </nav>

    <p class="font-inter text-light-gray text-xs">
      © {currentYear} by HEIJO studio
    </p>
  </div>
</footer>
