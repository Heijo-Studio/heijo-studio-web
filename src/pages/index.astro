---
export const prerender = true;

import { Image } from 'astro:assets';
import heroImage from '@assets/images/hero.webp';
import MainLayout from '@layouts/MainLayout.astro';
import { SOCIAL_LINKS } from 'src/constants';

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${Astro.site ?? ''}#organization`,
  name: 'Heijo Studio',
  url: Astro.site?.toString(),
  sameAs: SOCIAL_LINKS.map((l) => l.href),
  knowsAbout: [
    'Architecture',
    'Interior Design',
    'Art Installation',
    'Spatial Design',
  ],
};
---

<MainLayout
  description="Multi-disciplinary architecture and design studio connecting the dots through spatial research, interior design, and art installations."
  jsonLd={organizationSchema}
>
  <main class="container w-full max-w-full flex-1 overflow-hidden">
    <section class="flex h-full w-full flex-col">
      <div class="relative flex-1 overflow-hidden">
        <Image
          src={heroImage}
          alt="hero-image"
          loading="eager"
          fetchpriority="high"
          sizes="100vw"
          class="h-full w-full object-cover"
        />
        <div
          class="pointer-events-none absolute inset-0 bg-black/20 md:bg-none"
        >
        </div>
      </div>

      <h1
        class="font-inter absolute top-1/2 right-4 left-4 -translate-y-1/2 text-3xl font-normal text-white/80 md:top-[35%] md:right-[10%] md:left-auto md:max-w-md md:translate-y-0 md:text-4xl"
      >
        Connecting the dots with multi-disciplinary design solutions
      </h1>
    </section>
  </main>
</MainLayout>
