---
import { getCollection } from 'astro:content';
import ProjectItem from '@components/Works/ProjectItem.astro';
import WorksLayout from '@layouts/WorksLayout.astro';

const allWorks = await getCollection('works');
---

<WorksLayout
  title="Works"
  description="Explore the full portfolio of Heijo Studio — architecture, interior design, art installations, and spatial design projects."
>
  <main>
    <div
      class="grid grid-cols-1 gap-12 pb-8 sm:grid-cols-2 md:gap-6 lg:grid-cols-3"
    >
      {allWorks.map((project) => <ProjectItem project={project} />)}
    </div>
  </main>
</WorksLayout>
