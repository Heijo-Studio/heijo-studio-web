---
import { getImage } from 'astro:assets';
import { getEntry, render } from 'astro:content';
import CollapsibleContent from '@components/ProjectDetails/CollapsibleContent.astro';
import Gallery from '@components/ProjectDetails/Gallery.astro';
import ProjectSpecs from '@components/ProjectDetails/ProjectSpecs.astro';
import Prose from '@components/ProjectDetails/Prose.astro';
import Tag from '@components/ProjectDetails/Tag.astro';
import Thumbnail from '@components/ProjectDetails/Thumbnail.astro';
import MainLayout from '@layouts/MainLayout.astro';

const { category, slug } = Astro.params;

if (!category || !slug) {
  throw new Error('Category and slug are required');
}

const entry = await getEntry('works', `${category}/${slug}`);
if (!entry) {
  return Astro.redirect('/404');
}

const { data } = entry;
const {
  title,
  construction,
  description: frontmatterDescription,
  design,
  tags,
  location,
  size,
  thumbnail,
  gallery,
} = data;
const { Content } = await render(entry);

// Three-tier description fallback
let description: string | undefined;
if (frontmatterDescription && frontmatterDescription.length > 0) {
  description = frontmatterDescription;
} else if (entry.body?.trim()) {
  description = entry.body
    .trim()
    .replace(/^#{1,6}\s+/gm, '')
    .replace(/\*{1,2}([^*]+)\*{1,2}/g, '$1')
    .replace(/_{1,2}([^_]+)_{1,2}/g, '$1')
    .replace(/`[^`]+`/g, '')
    .replace(/\[([^\]]+)\]\([^)]+\)/g, '$1')
    .replace(/\n+/g, ' ')
    .trim()
    .slice(0, 160);
}

// OG image via getImage()
let ogImage: string | undefined;
if (thumbnail && Astro.site) {
  const imageResult = await getImage({
    src: thumbnail,
    width: 1200,
    format: 'jpeg',
  });
  ogImage = new URL(imageResult.src, Astro.site).toString();
}

// Category display name
const displayCategory = category
  .split('-')
  .map((w) => w.charAt(0).toUpperCase() + w.slice(1))
  .join(' ');

// CreativeWork JSON-LD
const canonicalUrl = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).toString()
  : Astro.url.href;

const projectSchema: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: title,
  url: canonicalUrl,
  creator: {
    '@type': 'Organization',
    '@id': `${Astro.site ?? ''}#organization`,
    name: 'Heijo Studio',
  },
  genre: displayCategory,
};

if (description) projectSchema.description = description;
if (construction) projectSchema.dateCreated = construction.toISOString();
if (location)
  projectSchema.locationCreated = { '@type': 'Place', name: location };
if (tags?.length) projectSchema.keywords = tags.join(', ');
if (ogImage) projectSchema.image = [{ '@type': 'ImageObject', url: ogImage }];
---

<MainLayout
  title={title}
  description={description}
  ogImage={ogImage}
  ogType="article"
  jsonLd={projectSchema}
>
  <main class="h-full w-full max-w-full overflow-x-hidden pt-16 md:pt-0">
    <Thumbnail image={thumbnail} title={title} />

    <div class="flex justify-center px-8 pt-6 pb-6 md:px-0">
      <div class="w-full max-w-342.5">
        <h1 class="font-inter text-light-gray text-3xl font-medium md:text-5xl">
          {title}
        </h1>
      </div>
    </div>

    <div class="flex w-full justify-center px-8 md:px-0">
      <div
        class="flex w-full max-w-342.5 flex-col gap-y-8 pb-8 md:flex-row md:gap-x-12 md:pt-8"
      >
        <div class="order-2 md:order-1 md:w-48 md:shrink-0">
          <ProjectSpecs
            construction={construction}
            design={design}
            location={location}
            size={size}
          />
        </div>

        <div class="order-1 md:order-2 md:flex-1">
          <CollapsibleContent>
            <Prose>
              <Content />
            </Prose>
          </CollapsibleContent>
        </div>
      </div>
    </div>

    <div class="flex w-full justify-center px-8 pb-8 md:px-0">
      <div class="w-full max-w-342.5">
        <Gallery items={gallery} />
      </div>
    </div>

    {
      tags && tags.length > 0 && (
        <div class="flex w-full justify-center px-8 pb-12 md:px-0">
          <div class="w-full max-w-342.5">
            <div class="flex flex-wrap gap-x-5 gap-y-3">
              {tags.map((tag) => (
                <Tag text={tag} />
              ))}
            </div>
          </div>
        </div>
      )
    }
  </main>
</MainLayout>
