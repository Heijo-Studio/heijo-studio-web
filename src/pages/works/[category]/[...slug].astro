---
import { getEntry, render } from 'astro:content';
import Gallery from '@components/ProjectDetails/Gallery.astro';
import ProjectSpecs from '@components/ProjectDetails/ProjectSpecs.astro';
import Prose from '@components/ProjectDetails/Prose.astro';
import Tag from '@components/ProjectDetails/Tag.astro';
import Thumbnail from '@components/ProjectDetails/Thumbnail.astro';
import MainLayout from '@layouts/MainLayout.astro';

const { category, slug } = Astro.params;

if (!category || !slug) {
  throw new Error('Category and slug are required');
}

const entry = await getEntry('works', `${category}/${slug}`);
if (!entry) {
  return Astro.redirect('/404');
}

const { data } = entry;
const {
  title,
  construction,
  design,
  tags,
  location,
  size,
  thumbnail,
  gallery,
} = data;
const { Content } = await render(entry);
---

<MainLayout title={`${title} | Heijo Studio`}>
  <main class="h-full w-full max-w-full overflow-x-hidden">
    <!-- Header Title (Stacked on mobile) -->
    <div class="flex justify-center px-8 pt-24 pb-6 md:px-0 md:pt-8">
      <div class="w-full max-w-342.5">
        <h1 class="font-inter text-light-gray text-3xl font-medium md:text-5xl">
          {title}
        </h1>
      </div>
    </div>

    <Thumbnail image={thumbnail} title={title} />

    <div class="flex w-full justify-center px-8 md:px-0">
      <div
        class="flex w-full max-w-342.5 flex-col gap-y-12 py-8 md:flex-row md:justify-between md:gap-x-12"
      >
        <!-- Mobile: Gallery moves up -->
        <div class="order-1 md:order-2 md:w-1/2">
          <Gallery items={gallery} />
        </div>

        <div class="order-2 flex flex-col gap-y-10 md:order-1 md:w-1/2">
          <ProjectSpecs
            construction={construction}
            design={design}
            location={location}
            size={size}
          />

          <Prose>
            <Content />
          </Prose>

          <div class="flex flex-wrap gap-x-5 gap-y-3">
            {tags?.map((tag) => <Tag text={tag} />)}
          </div>
        </div>
      </div>
    </div>
  </main>
</MainLayout>
